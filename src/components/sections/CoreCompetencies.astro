---
import Section from "../Section.astro";

interface CompetenceGroup {
  description: string;
  competences: string[];
}

interface Props {
  items: CompetenceGroup[];
  title: string;
}

const { items, title } = Astro.props;
---

<Section title={title}>
  <div class="competencies-container">
    {
      items.map(({ description, competences }) => (
        <div class="competency-item">
          <p class="description">
            <strong>{description}</strong> {competences.join(", ")}
          </p>
        </div>
      ))
    }
  </div>
</Section>

<style>
  .competencies-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .competency-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .description {
    margin: 0;
    color: #111;
    font-size: 0.9rem;
    text-align: justify;
  }

  .competences-list {
    margin: 0;
    color: #666;
    font-size: 0.85rem;
    line-height: 1.4;
  }
</style>
